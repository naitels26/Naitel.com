# Copia a .env y completa solamente en el servidor.
GEMINI_API_KEY=
# Modelo de texto comprobado con este proyecto.
GEMINI_MODEL=gemini-flash-lite-latest
PORT=4173

# Microsoft 365 / Microsoft Graph: aplicación con permiso de aplicación Mail.Send
# y consentimiento de administrador. Nunca colocar estos valores en el navegador.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=aleon@naitel.com
